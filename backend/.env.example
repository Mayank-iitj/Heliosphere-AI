# ===== HelioSphere AI backend configuration =====
APP_NAME="HelioSphere AI"
ENV=development                       # development | production
DEBUG=true

# Security — CHANGE in production
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database — SQLite by default (zero-setup). For Postgres:
#   DATABASE_URL=postgresql+asyncpg://helio:helio@localhost:5432/heliosphere
DATABASE_URL=sqlite+aiosqlite:///./heliosphere.db

# Cache — optional. If unset/unreachable, an in-process fallback cache is used.
# REDIS_URL=redis://localhost:6379/0

# CORS — comma separated; "*" allows all (dev only)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# HelioGPT copilot — optional. Without a key, a grounded local fallback answers.
# GEMINI_API_KEY=

# Background ingestion scheduler
SCHEDULER_ENABLED=true
INGEST_INTERVAL_SECONDS=60

# Default admin bootstrapped on first run
ADMIN_EMAIL=admin@heliosphere.ai
ADMIN_PASSWORD=helioadmin123
