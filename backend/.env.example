# ===== HelioSphere AI backend — .env.example =====
APP_NAME="HelioSphere AI"
ENV=production
DEBUG=false

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database — SQLite by default. For Postgres on Render/Railway:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./heliosphere.db

# CORS — set to your Vercel frontend URL in production
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# HelioGPT copilot — Groq API key (llama-3.3-70b-versatile)
# Get yours at https://console.groq.com  |  free tier is sufficient
# Without a key the rule-based engine is used — copilot always works.
GROQ_API_KEY=gsk_your_groq_key_here

# Background ingestion scheduler
SCHEDULER_ENABLED=true
INGEST_INTERVAL_SECONDS=60

# Default admin bootstrapped on first run — CHANGE in production
ADMIN_EMAIL=admin@heliosphere.ai
ADMIN_PASSWORD=helioadmin123
