# ===== HelioSphere AI frontend — .env.example =====
# Copy to .env.local and fill in your values.

# Server-side proxy target for the FastAPI backend.
# In production: set to your Render/Railway/Fly backend URL.
API_PROXY_TARGET=http://localhost:8000

# App display name
NEXT_PUBLIC_APP_NAME=HelioSphere AI

# Groq API key — server-side only (never exposed to browser)
# Powers the /api/copilot/ask route handler (llama-3.3-70b-versatile)
# Get a free key at https://console.groq.com
# Without this, a grounded rule-based engine answers instead.
GROQ_API_KEY=gsk_your_groq_key_here
